.venv/
.env
.env.*
!.env.example
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/
*.egg-info/
build/
dist/

data/raw/*
data/interim/*
data/processed/*
artifacts/*
outputs/figures/*
outputs/tables/*

!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!artifacts/.gitkeep
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep

# Version 1.0 final-evaluation namespace -- isolated from the development
# caches above by design (see CLAUDE.md "The one narrow exception: the
# sealed Version 1.0 final evaluation"). The 2025 raw/derived data and every
# run output/artifact this produces must never be committed, exactly like
# the development caches.
data/final_evaluation/*
outputs/final_evaluation/*
!artifacts/final_evaluation/
artifacts/final_evaluation/*

!data/final_evaluation/.gitkeep
!outputs/final_evaluation/.gitkeep
!artifacts/final_evaluation/.gitkeep

# Version 1.1 prospective 2026 scoring namespace -- isolated from the
# development caches and the sealed Version 1.0 namespace above (see
# CLAUDE.md "Version 1.1: prospective 2026 scoring"). Real 2026 raw data and
# every snapshot run's outputs/artifacts must never be committed. This is
# also load-bearing for the working-tree-clean guard
# (prospective.prospective_ingestion.run_prospective_guards): `git status
# --porcelain` never lists an ignored file, so a snapshot run writing here
# never falsely dirties the tree for a SUBSEQUENT run.
data/prospective/*
outputs/prospective/*
!artifacts/prospective/
artifacts/prospective/*

!data/prospective/.gitkeep
!outputs/prospective/.gitkeep
!artifacts/prospective/.gitkeep

# Version 1.4.0 Phase 5: ephemeral Play Explorer browser-artifact build
# output (scripts/generate_production_explorer_artifacts.py), one
# subdirectory per snapshot. Deployment artifacts, not canonical scoring
# artifacts -- never archived into the canonical R2 snapshot, and (like the
# prospective namespace above) gitignored so a snapshot's own build output
# can never falsely dirty the working-tree-clean guard for a later run.
outputs/explorer_build/*
!outputs/explorer_build/.gitkeep

# macOS
.DS_Store

# Cloudflare Wrangler local cache/state (account ID, project name -- no
# secrets; the actual auth token lives outside the repo in the user's
# global Wrangler config).
.wrangler/

# Microsoft Playwright MCP scratch output. The rendered-verification step in
# CLAUDE.md ("not done until it has been rendered and looked at") writes this
# directory into the repository root on every run. It is not just untidy:
# `prospective.prospective_ingestion.run_prospective_guards` treats an
# untracked-but-not-ignored path as a dirty tree and HARD-BLOCKS every real
# snapshot run, so a leftover scratch dir stops production scoring.
.playwright-mcp/

# Contact Forecast research layer (forecast/). Derived walk-forward play
# ledgers and every result artifact the study writes. Research outputs, not
# canonical scoring artifacts -- and gitignored for the same reason as the
# prospective namespace above: a prior run's own output must never dirty the
# working tree and block a later production snapshot.
data/forecast/*
!data/forecast/.gitkeep
outputs/forecast_research/*
!outputs/forecast_research/.gitkeep

# Contact Forecast Phase 2 (forecast/phase2/): the held-out 2026 evaluation's
# artifacts. Research outputs, gitignored for the same reason as the
# development namespace above -- a prior run's own output must never dirty the
# working tree and block a later production snapshot.
outputs/forecast_phase2/

# Contact Forecast horizon scoping study (exploratory, development-only).
outputs/forecast_horizon_scope/

# Contact Forecast Phase 2 H=200 specification namespace.
outputs/forecast_phase2_h200/

# Contact Forecast end-of-season 2026 resolution pass namespace.
outputs/forecast_phase2_resolution/

# 2027 projection model (projection/): development results, and later the
# frozen projections and the 2027 grade. Never committed; a run's own output
# must never dirty the tree for the next guarded run.
outputs/projection_2027/

# Version 0.14 pitcher-replication namespace -- isolated from the
# development caches, the sealed Version 1.0 namespace and the Version 1.1
# prospective namespace (see replication/pitcher_replication_freeze.py).
# The freeze artifact and any future 2025 replication raw/derived data live
# here and are never committed, and (like the namespaces above) are ignored
# so a run's own output can never falsely dirty the working-tree-clean guard
# for a later run.
data/pitcher_replication/*
outputs/pitcher_replication/*
!artifacts/pitcher_replication/
artifacts/pitcher_replication/*

!data/pitcher_replication/.gitkeep
!outputs/pitcher_replication/.gitkeep
!artifacts/pitcher_replication/.gitkeep
